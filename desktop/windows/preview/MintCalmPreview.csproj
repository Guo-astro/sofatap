<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Sofatap.MintCalmPreview</AssemblyName>
    <ApplicationIcon>../Assets/SofaTap.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Assets/SofaTap.ico" LogicalName="Sofatap.AppIcon" />
    <Compile Include="../PairingWindow.cs" Link="PairingWindow.cs" />
    <Compile Include="../MintCalmControls.cs" Link="MintCalmControls.cs" />
    <Compile Include="../NativeProtocol.cs" Link="NativeProtocol.cs" />
    <Compile Include="../BackendProcess.cs" Link="BackendProcess.cs" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>
</Project>
